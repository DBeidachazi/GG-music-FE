# GG Music 本地开发配置示例
# 复制此文件为 .env.local 进行本地自定义配置

# 前端开发服务器端口
VUE_APP_DEV_PORT=13580

# 后端API服务器端口
VUE_APP_API_PORT=13579

# 后端API地址
VUE_APP_API_BASE_URL=http://localhost:13579

# 自定义用户UID（可修改为你自己的）
VUE_APP_DEFAULT_UID=639d9d87232a328835

# 每页加载歌曲数量
VUE_APP_PAGE_SIZE=15
